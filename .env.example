# --- Claude (turns the transcript into tickets) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Jira Cloud ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ
# Fallback issue type if Bug/Story don't exist in your project
JIRA_ISSUE_TYPE=Task
# Optional: custom field id for Acceptance Criteria (e.g. customfield_10050).
# Leave empty to put acceptance criteria in the ticket description.
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# --- Team roster: team.json by default, or inline JSON ---
TEAM_FILE=team.json
# TEAM_JSON=[{"name": "Ada Obi", "email": "ada@yourcompany.com", "aliases": ["Ada"]}]

# --- Google Drive folder that receives Meet transcripts (the "TranscripTonic" folder) ---
DRIVE_FOLDER_ID=
# Paste the whole service-account key JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
# Only look at transcripts created in the last N days
PROCESS_SINCE_DAYS=7

# --- Reminders (all optional; without them reminders are only logged) ---
# Gmail: smtp.gmail.com / 587 with an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SLACK_WEBHOOK_URL=
# Reminders go to anyone with open tickets not updated in this many hours
REMINDER_STALE_HOURS=6
